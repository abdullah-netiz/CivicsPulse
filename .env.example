# Copy to .env and adjust. Never commit .env -- it is gitignored.
# Every value here is non-secret by default; put real keys only in .env.

POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://civicpulse:change-me@postgres:5432/civicpulse
REDIS_URL=redis://redis:6379/0

# TRIAGE_PROVIDER: simulated | rules | llm (Groq) | ollama | gemini
TRIAGE_PROVIDER=simulated

# Groq (https://console.groq.com) -- free tier, no credit card.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
TRIAGE_TIMEOUT_SECONDS=10

# Ollama -- offline container path (compose profile: offline-ai).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Alternative hosted provider (free tier; see ADR 0004 for the PII trade-off).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

CORS_ORIGINS=http://localhost:8080
